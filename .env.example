# ---- Telegram (BotFather) ----
BOT_TOKEN=123456:replace-me
OWNER_USER_ID=111111111            # your Telegram user ID (message @userinfobot)
GROUP_CHAT_ID=-1001234567890       # your private supergroup's ID (starts with -100)

# ---- Storage ----
STORAGE=sheets                     # sheets | memory (memory = local experiments, nothing persists)
SHEET_ID=the-long-id-in-your-sheet-url
GOOGLE_CREDENTIALS_JSON=           # service-account JSON (paste raw JSON, or base64 of it)

# ---- Hosting (Railway) ----
MODE=webhook                       # webhook | polling (polling = local development)
PUBLIC_URL=https://your-app.up.railway.app
WEBHOOK_SECRET=                    # 16+ random characters, sent by Telegram in a header
WEBHOOK_PATH=                      # 16+ random characters, part of the webhook URL
GUIDE_TOKEN=                       # 16+ random characters, part of the help-guide URL
PORT=8080
TZ=Asia/Singapore

# ---- Optional ----
ANTHROPIC_API_KEY=                 # enables "ask a question about my data" (read-only)
LLM_MODEL=claude-sonnet-5-5
ALLOW_PRIVATE_CHAT=false           # true also answers you in a direct chat with the bot
LOG_LEVEL=INFO
